+ * always on once powered, as mainline does for ERR009619 (imx6qp_dt_data
+ * err009619_present -> GENPD_FLAG_ALWAYS_ON). Powering PU down on the QuadPlus
+ * with this kernel locks the SoC. */
+static bool pu_always_on(void)
+{
+	u32 digprog = __raw_readl(MX6_IO_ADDRESS(ANATOP_BASE_ADDR) + 0x260);
+	return ((digprog >> 16) & 0xff) == 0x63 && ((digprog >> 8) & 0xff) == 0x01;
+}
