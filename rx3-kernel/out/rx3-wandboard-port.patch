+/* ------------------------------------------------------------------------ */
+
+/* [rx3-wandboard] i.MX6 QuadPlus (Wandboard rev D1): ANATOP DIGPROG = 0x0063_01xx.
+ * This 3.0 kernel predates the QuadPlus; its busfreq (DDR/bus clock scaling)
+ * locks the SoC in busfreq_probe, so leave the bus at the rate u-boot set. */
+static __init bool wand_is_mx6qp(void) {
+	u32 digprog = __raw_readl(MX6_IO_ADDRESS(ANATOP_BASE_ADDR) + 0x260);
+	return ((digprog >> 16) & 0xff) == 0x63 && ((digprog >> 8) & 0xff) == 0x01;
+}
+
+static __init void wand_init_pm(void) {
+	enable_wait_mode = false;
+	imx6q_add_anatop_thermal_imx(1, &wand_thermal);
+        imx6_add_armpmu();
+	imx6q_add_pm_imx(0, &wand_pm_data);
+	if (wand_is_mx6qp()) {
+		printk(KERN_INFO "wandboard: i.MX6 QuadPlus - busfreq/dvfs-core disabled\n");
+		/* The QuadPlus IPU fetches through the PRG; ungate PRG0 like u-boot's
+		 * enable_ipu_clock() (CCGR6 bits 25:24, "PRG_CLK0 exists on i.MX6QP"). */
+		__raw_writel(__raw_readl(MX6_IO_ADDRESS(CCM_BASE_ADDR) + 0x80) | (3 << 24),
+			     MX6_IO_ADDRESS(CCM_BASE_ADDR) + 0x80);
+		return;
+	}
+	imx6q_add_dvfs_core(&wand_dvfscore_data);
+	imx6q_add_busfreq();
+}
