+
+static int wand_set_spdif_clk_rate(struct clk *clk, unsigned long rate) {
+	unsigned long rate_actual;
+	rate_actual = clk_round_rate(clk, rate);
+	clk_set_rate(clk, rate_actual);
+	return 0;
+}
