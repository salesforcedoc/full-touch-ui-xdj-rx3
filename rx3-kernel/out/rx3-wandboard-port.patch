+++ b/arch/arm/mach-mx6/cpu.c
@@ -82,6 +82,12 @@ static int mx6_get_srev(void)
 	else
 		rev = __raw_readl(anatop + MX6_USB_ANALOG_DIGPROG);
 
+	/* [rx3-wandboard] i.MX6 QuadPlus: DIGPROG 0x0063_01xx. This kernel predates it and
+	 * would report rev 1.0 (low byte 0), taking rev-1.0 paths (GPT on ipg_perclk,
+	 * GPU2D mux) that are wrong on the QuadPlus. Report it as 2.0, as NXP does. */
+	if (!cpu_is_mx6sl() && ((rev >> 16) & 0xff) == 0x63 && ((rev >> 8) & 0xff) == 0x01)
+		return IMX_CHIP_REVISION_2_0;
+
 	rev &= 0xff;
 
